<%- include('partials/header') %>

<% if (success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="card shadow-sm border-0">
  <div class="card-body">
    
    <!-- Top Controls: Show Entries & Search -->
    <div class="row mb-3 align-items-center">
      <div class="col-md-6 d-flex align-items-center mb-2 mb-md-0">
        <label class="me-2 text-muted fw-semibold">Show</label>
        <select id="limitSelect" class="form-select form-select-sm w-auto d-inline-block" onchange="changeLimit(this)">
          <option value="5" <%= limit === 5 ? 'selected' : '' %>>5</option>
          <option value="10" <%= limit === 10 ? 'selected' : '' %>>10</option>
          <option value="15" <%= limit === 15 ? 'selected' : '' %>>15</option>
        </select>
        <label class="ms-2 text-muted fw-semibold">entries</label>
      </div>

      <div class="col-md-6 d-flex justify-content-md-end align-items-center">
        <form action="/" method="GET" class="input-group input-group-sm w-auto">
          <span class="input-group-text bg-white"><i class="fa-solid fa-search"></i></span>
          <input type="text" name="search" class="form-control" placeholder="Search by name, email, phone..." value="<%= search %>">
          <input type="hidden" name="limit" value="<%= limit %>">
          <button class="btn btn-dark" type="submit">Search</button>
          <% if (search) { %>
            <a href="/" class="btn btn-outline-secondary">Reset</a>
          <% } %>
        </form>
      </div>
    </div>

    <!-- Multiple Delete Button Form -->
    <form id="multiDeleteForm" action="/delete-multiple" method="POST">
      <div class="mb-3">
        <button type="button" id="deleteSelectedBtn" class="btn btn-danger btn-sm" disabled onclick="confirmMultiDelete()">
          <i class="fa-solid fa-trash-can me-1"></i> Delete Selected
        </button>
      </div>

      <!-- Data Table -->
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead>
            <tr>
              <th scope="col" width="40"><input type="checkbox" id="selectAll" class="form-check-input"></th>
              <th scope="col" width="60"># ID</th>
              <th scope="col" width="80">Image</th>
              <th scope="col">Name</th>
              <th scope="col">E-Mail</th>
              <th scope="col">Phone</th>
              <th scope="col" width="90">Status</th>
              <th scope="col" width="100" class="text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (records && records.length > 0) { %>
              <% records.forEach((record, index) => { %>
                <tr>
                  <td>
                    <input type="checkbox" name="ids" value="<%= record._id %>" class="form-check-input recordCheckbox">
                  </td>
                  <td class="fw-bold text-secondary"><%= (currentPage - 1) * limit + index + 1 %></td>
                  <td>
                    <% if (record.image) { %>
                      <img src="/uploads/<%= record.image %>" alt="<%= record.name %>" class="avatar-img">
                    <% } else { %>
                      <img src="https://via.placeholder.com/45" alt="Default" class="avatar-img">
                    <% } %>
                  </td>
                  <td class="fw-semibold"><%= record.name %></td>
                  <td><%= record.email %></td>
                  <td><%= record.phone %></td>
                  <td>
                    <% if (record.status) { %>
                      <span class="badge bg-success">Active</span>
                    <% } else { %>
                      <span class="badge bg-secondary">Inactive</span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <a href="/edit/<%= record._id %>" class="text-success me-2 fs-6" title="Edit">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                    <a href="/delete/<%= record._id %>" class="text-danger fs-6" title="Delete" onclick="return confirm('Are you sure you want to delete this record?');">
                      <i class="fa-solid fa-trash"></i>
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center py-4 text-muted">No records found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </form>

    <!-- Pagination & Info Footer -->
    <div class="row mt-4 align-items-center">
      <div class="col-md-6 text-muted small">
        Showing <%= totalRecords > 0 ? (currentPage - 1) * limit + 1 : 0 %> to <%= Math.min(currentPage * limit, totalRecords) %> of <%= totalRecords %> entries
      </div>
      <div class="col-md-6 d-flex justify-content-md-end">
        <% if (totalPages > 1) { %>
          <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
              <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="/?page=<%= currentPage - 1 %>&limit=<%= limit %>&search=<%= search %>">Previous</a>
              </li>
              <% for(let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                  <a class="page-link" href="/?page=<%= i %>&limit=<%= limit %>&search=<%= search %>"><%= i %></a>
                </li>
              <% } %>
              <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="/?page=<%= currentPage + 1 %>&limit=<%= limit %>&search=<%= search %>">Next</a>
              </li>
            </ul>
          </nav>
        <% } %>
      </div>
    </div>

  </div>
</div>

<script>
  // Select All Checkboxes
  const selectAll = document.getElementById('selectAll');
  const recordCheckboxes = document.querySelectorAll('.recordCheckbox');
  const deleteSelectedBtn = document.getElementById('deleteSelectedBtn');

  function updateDeleteButtonState() {
    const checkedCount = document.querySelectorAll('.recordCheckbox:checked').length;
    deleteSelectedBtn.disabled = checkedCount === 0;
  }

  if (selectAll) {
    selectAll.addEventListener('change', function() {
      recordCheckboxes.forEach(cb => {
        cb.checked = selectAll.checked;
      });
      updateDeleteButtonState();
    });
  }

  recordCheckboxes.forEach(cb => {
    cb.addEventListener('change', function() {
      updateDeleteButtonState();
      if (!cb.checked && selectAll) {
        selectAll.checked = false;
      }
    });
  });

  function confirmMultiDelete() {
    if (confirm('Are you sure you want to delete all selected records?')) {
      document.getElementById('multiDeleteForm').submit();
    }
  }

  function changeLimit(select) {
    const limit = select.value;
    const urlParams = new URLSearchParams(window.location.search);
    urlParams.set('limit', limit);
    urlParams.set('page', '1');
    window.location.search = urlParams.toString();
  }
</script>

<%- include('partials/footer') %>
